      font-size: 0.88rem;
      padding-left: 18px;
      position: relative;
    }
    .reasons li::before {
      content: '▸';
      position: absolute;
      left: 0;
      color: var(--accent);
    }
    .result-cta { flex: none; }

    .results-note {
      margin-top: 22px;
      font-size: 0.68rem;
      letter-spacing: 0.06em;
      color: var(--faint);
    }
  </style>
