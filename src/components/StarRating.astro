---
interface Props {
  rating: number;
  showValue?: boolean;
}

const { rating, showValue = true } = Astro.props;
const pct = Math.max(0, Math.min(100, (rating / 5) * 100));
---

<span class="star-wrap" title={`${rating} out of 5`}>
  <span class="stars" aria-hidden="true">
    ★★★★★
    <span class="fill" style={`width: ${pct}%`}>★★★★★</span>
  </span>
  {showValue && <span class="mono star-value">{rating.toFixed(1)}</span>}
  <span class="sr-only">{rating} out of 5 stars</span>
</span>

<style>
  .star-wrap { display: inline-flex; align-items: center; gap: 6px; }
  .star-value { font-size: 0.78rem; color: var(--amber); font-weight: 600; }
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
