---
const year = new Date().getFullYear();

const explore = [
  { label: 'All Prop Firms', href: '/prop-firms/' },
  { label: 'Challenges', href: '/prop-firm-challenges' },
  { label: 'Compare Firms', href: '/compare-firms/' },
  { label: 'Match Quiz', href: '/match' },
  { label: 'Offers & Discounts', href: '/offers' },
];

const verticals = [
  { label: 'Forex Prop Firms', href: '/prop-firms/?vertical=cfd' },
  { label: 'Futures Prop Firms', href: '/futures' },
  { label: 'Crypto Prop Firms', href: '/prop-firms/?vertical=crypto' },
];
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <span class="brand-mark" aria-hidden="true">PM</span>
      <p class="footer-title">PropFirm Match <span class="accent-text">Clone</span></p>
      <p class="muted footer-blurb">
        An independent comparison platform for prop trading firms. Ratings,
        challenge rules, fees and discount codes — all in one terminal.
      </p>
    </div>

    <nav aria-label="Explore">
      <p class="footer-heading">Explore</p>
      <ul>
        {explore.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}
      </ul>
    </nav>

    <nav aria-label="Verticals">
      <p class="footer-heading">Verticals</p>
      <ul>
        {verticals.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}
      </ul>
    </nav>

    <div>
      <p class="footer-heading">Data policy</p>
      <p class="muted footer-blurb">
        All figures come from our own research dataset and are refreshed
        regularly. Entries marked <span class="mono accent-text">estimated</span>
        are approximations pending verification.
      </p>
    </div>
  </div>

  <div class="wrap footer-base">
    <p class="mono">© {year} PropFirm Match Clone — demo project. Not financial advice.</p>
    <p class="mono snapshot">
      Data snapshot: 2026-08-24 — fees, splits &amp; rules change often. Always
      verify with the firm before purchasing.
    </p>
    <p class="mono">Trading leveraged products carries a high level of risk.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--bg-raised);
    margin-top: 40px;
    position: relative;
    z-index: 1;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
    gap: 40px;
    padding-block: 56px 40px;
  }
  .footer-brand { display: grid; gap: 12px; justify-items: start; }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--accent-ink);
    background: linear-gradient(135deg, var(--accent), var(--accent-dim));
  }
  .footer-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
  }
  .footer-blurb { font-size: 0.88rem; max-width: 34ch; }
  .footer-heading {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 14px;
  }
  nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  nav a { color: var(--muted); font-size: 0.92rem; transition: color 0.15s ease; }
  nav a:hover { color: var(--accent); }
  .footer-base {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-block: 18px;
    font-size: 0.72rem;
    color: var(--faint);
  }
  .footer-base .snapshot { color: var(--amber); }
  .footer-base p { margin: 0; }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
