---
/**
 * FilterBar renders the directory filter controls. The filtering logic lives
 * in the inline script on /prop-firms and reads these control IDs.
 */
---

<section class="panel filterbar rise" aria-label="Filter prop firms">
  <div class="fb-cell fb-search">
    <label for="filter-search">Search</label>
    <input id="filter-search" type="search" placeholder="Firm, platform, country…" autocomplete="off" />
  </div>

  <div class="fb-cell">
    <label for="filter-vertical">Vertical</label>
    <select id="filter-vertical">
      <option value="">All</option>
      <option value="cfd">Forex / CFD</option>
      <option value="futures">Futures</option>
      <option value="both">FX + Futures</option>
      <option value="crypto">Crypto assets</option>
    </select>
  </div>

  <div class="fb-cell">
    <label for="filter-min-account">Min account size</label>
    <select id="filter-min-account">
      <option value="">Any</option>
      <option value="25000">$25K+</option>
      <option value="50000">$50K+</option>
      <option value="100000">$100K+</option>
      <option value="200000">$200K+</option>
    </select>
  </div>

  <div class="fb-cell">
    <label for="filter-min-split">Min profit split</label>
    <select id="filter-min-split">
      <option value="">Any</option>
      <option value="80">80%+</option>
      <option value="85">85%+</option>
      <option value="90">90%+</option>
    </select>
  </div>

  <div class="fb-cell">
    <label for="filter-steps">Challenge steps</label>
    <select id="filter-steps">
      <option value="">Any</option>
      <option value="1">1-step</option>
      <option value="2">2-step</option>
    </select>
  </div>

  <div class="fb-cell fb-check">
    <label for="filter-discount">&nbsp;</label>
    <span class="check-wrap">
      <input id="filter-discount" type="checkbox" />
      <span>Has discount</span>
    </span>
  </div>

  <div class="fb-cell fb-reset">
    <button id="filter-reset" class="btn btn-ghost" type="button">Reset</button>
  </div>

  <p class="fb-count mono" id="filter-count" aria-live="polite"></p>
</section>

<style>
  .filterbar {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr auto auto;
    gap: 14px;
    align-items: end;
    padding: 18px;
  }
  .fb-cell { display: grid; gap: 0; min-width: 0; }
  .fb-search input { width: 100%; }
  .fb-check .check-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--muted);
    padding: 0.62em 0;
    white-space: nowrap;
    cursor: pointer;
  }
  .fb-check input { accent-color: var(--accent); width: 16px; height: 16px; cursor: pointer; }
  .fb-reset { padding-bottom: 1px; }
  .fb-count {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.72rem;
    color: var(--faint);
    letter-spacing: 0.08em;
  }
  @media (max-width: 1000px) {
    .filterbar { grid-template-columns: 1fr 1fr 1fr; }
    .fb-search { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .filterbar { grid-template-columns: 1fr 1fr; }
  }
</style>
